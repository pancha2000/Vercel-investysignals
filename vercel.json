{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "VERCEL": "1"
  },
  "crons": [
    {
      "path": "/api/cron/tpsl-check",
      "schedule": "*/1 * * * *"
    }
  ]
}
